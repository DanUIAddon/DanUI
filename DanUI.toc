# Wrapped in do-not-package: NoAutoclose.lua, Timeline.lua and Mover*.lua are
# ported from All Rights Reserved addons and may not be redistributed without
# their authors' permission (see CLAUDE.md, Licensing). The packager strips these
# lines from the released TOC; .gitignore keeps the files out of the public repo.
# The local install still loads them. Everything that calls into them is nil-guarded
# and the main window hides a module row whose panel does not exist.
#@do-not-package@
NoAutoclose.lua
#@end-do-not-package@
Groups.lua
AssistModule.lua
RaidToolsModule.lua
RaidAutomation.lua
Automation.lua
#@do-not-package@
Timeline.lua
#@end-do-not-package@
BreakTimer.lua
ReadyCheckPullTimer.lua
GuildBankSort.lua
WarbankGold.lua
GuildBankRestock.lua
BagItemLevel.lua

# AutoPayout (ported from Oppzippy's Auto Payout, reskinned for DUI)
